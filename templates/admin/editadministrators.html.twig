{% extends 'base.html.twig' %}

{% block title %}Modification Administrateurs{% endblock %}

{% block body %}

    <!--EDIT ADMIN START -->

    <main class="container-fluid" style="padding-right: 0px;padding-left: 0px;">

        <div class=" block text-center">
            <img src="../../img/Logo ok.jpg" class="img-fluid" alt="Logo Quai Antique">
            <h1 class="mt-3 text-center text-light">Modification Administrateurs</h1>

        </div>
        <section class="container">
            <div class="row">
                <div class="col">
                    {{ form_start(form) }}
                    <fieldset>

                        {{ form_row(form.lastName) }}
                        {{ form_row(form.firstName) }}
                        {{ form_row(form.allergie) }}
                        {{ form_row(form.phoneNumber) }}
                        {{ form_row(form.email) }}

                    </fieldset>

                    <div class="text-center mb-3">
                        <button type="submit" class="btn btn-ml btn-outline-danger mt-5 text-dark">Modifier</button>
                        {{ form_end(form) }}
                    </div>

                </div>
            </div>
        </section>

    </main>

    <!--EDIT ADMIN END -->

{% endblock %}