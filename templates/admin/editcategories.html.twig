{% extends 'base.html.twig' %}

{% block title %}Modification catégorie{% endblock %}

{% block body %}

<!-- EDIT CATEGORY START -->
<div class=" container-fluid text-center ">
    <img src="../../img/logo.jpg" class="img-fluid" alt="Logo Quai Antique">
    <h2 class="mt-3 text-center text-dark">Modification catégorie</h2>
</div>

<main>

    <section class="container">
        <div class="row">
            <div class="col">
                <form class="container-fluid" method="post">
                    {{ form_start(form) }}

                    <fieldset >

                        {{ form_row(form.nameCategory) }}

                    </fieldset>

                    <!-- BUTTON  START -->
                    <div class="text-center mb-3">
                        <button type="submit" class="btn btn-ml btn-outline-danger mt-5 text-dark">Modifier</button>
                        {{ form_end(form) }}
                    </div>
                    <!-- BUTTON  END -->

                </form>

            </div>

        </div>

    </section>



</main>
<!-- EDIT CATEGORY END->
{% endblock %}
