{% extends 'base.html.twig' %}

{% block title %}Ajouter un Produit dans le Menu {% endblock %}

{% block body %}

    <!-- NEW PRODUCT START -->
    <div class=" container-fluid text-center ">
        <img src="../img/logo.jpg" class="img-fluid" alt="Logo Quai Antique">
        <h2 class="mt-3 text-center text-dark">Ajout d'un Produit dans le Menu</h2>
    </div>

    <main>

        <section class="container">
            <div class="row">
                <div class="col">
                    <form class="container-fluid" method="post">
                        {{ form_start(form) }}

                        <fieldset class="text-center">

                            <p class="row  mt-3 mb-3">
                            {{ form_row(form.category) }}
                            </p>

                            <p class="row  mt-3 mb-3">
                            {{ form_row(form.menu) }}
                            </p>

                            <p class="row  mt-3 mb-3">
                            {{ form_row(form.product) }}
                            </p>



                        </fieldset>

                        <!-- BUTTON  START -->
                        <div class="text-center mb-3">
                            <button type="submit" class="btn btn-ml btn-outline-danger mt-5 text-dark">Créer</button>
                            {{ form_end(form) }}
                        </div>
                        <!-- BUTTON  END -->

                    </form>

                </div>

            </div>

        </section>



    </main>
    <!-- NEW PRODUCT END->
{% endblock %}