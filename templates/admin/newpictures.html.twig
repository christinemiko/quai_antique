{% extends 'base.html.twig' %}

{% block title %}Création Image{% endblock %}

{% block body %}

    <!-- NEW PICTURE START -->
    <div class=" container-fluid text-center ">
        <img src="../img/logo.jpg" class="img-fluid" alt="Logo Quai Antique">
        <h2 class="mt-3 text-center text-dark">Création Image</h2>
    </div>

    <main>

        <section class="container">
            <div class="row">
                <div class="col">
                    <form class="container" method="post">
                        {{ form_start(form) }}

                        <fieldset class="text-center">

                            <p class="row  mt-3 mb-3">
                            {{ form_row(form.namePicture) }}
                            </p>

                            <p class="row  mt-3 mb-3">
                            {{ form_row(form.link) }}
                            </p>

                            <p class="row  mt-3 mb-3">
                            {{ form_row(form.product) }}
                            </p>

                        </fieldset>

                        <!-- BUTTON  START -->
                        <div class="text-center mb-3">
                            <button type="submit" class="btn btn-ml btn-outline-danger mt-5 text-dark">Créer</button>
                            {{ form_end(form) }}
                        </div>
                        <!-- BUTTON  END -->

                    </form>

                </div>

            </div>

        </section>



    </main>
    <!-- NEW PICTURE END->
{% endblock %}