{% extends "base.html.twig" %}

 {% block title %}Créer une Réservation{% endblock %}

 {% block body %}
     <!-- FLATPICKR CDN -->
     <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
     <!-- RESERVATION PAGE START -->
     <main class="container-fluid" style="padding-left: 0px;padding-right: 0px;">

         <div class=" block text-center">
             <img src="../img/logo ok.jpg" class="img-fluid" alt="Logo Quai Antique">
             <h1 class="mt-3 text-center text-light">Créer une Réservation</h1>
         </div>


         <section class="container">
             <div class="row">
                 <div class="col mt-5">
                     {{ form_start(form ) }}
                     <fieldset>

                         <span>Places disponibles : </span><span id="available-places" class="text-danger">{{ availablePlace }}</span>
                         {{ form_errors(form) }}

                         <a class="row  mt-4 mb-4 text-dark">
                             {{ form_row(form.dateReservation) }}
                         </a>

                         <a class="row  mt-4 mb-4 text-dark">
                             {{ form_row(form.hourReservation) }}
                         </a>

                         <div class="row  mt-4 mb-4">
                         {{ form_row(form.numberPerson) }}
                         </div>

                         <div class="row  mt-4 mb-4">
                         {{ form_row(form.message) }}
                         </div>

                         <div class="row  mt-4 mb-4">
                             <div class="col col-md-6 text-dark ">
                                 {{ form_row(form.user) }}
                             </div>
                         </div>

                     </fieldset>

                     <div class="text-center mb-3">
                         <button type="submit" class="btn btn-ml btn-outline-danger mt-5 text-dark">Valider</button>
                         {{ form_end(form) }}
                     </div>
                 </div>
             </div>
         </section>
     </main>

     <!-- RESERVATION PAGE END -->

 {% endblock %}

{% block custom_javascripts %}
    <!-- FLATPICKR   CDN -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
    <script>
        flatpickr('.flatpickr-date', {
            dateFormat: 'Y-m-d',
            locale: 'fr',
            disableMobile: true,
            defaultDate: 'today',
            minDate: 'today',
            altInput: true,
            altFormat: 'd M Y',
            disable: [
                function(date) {
                    return (date.getDay() === 0); // 0 = dimanche
                }
            ],

        });

    </script>
    <script>


        function checkAvailibility() {
            let date = document.querySelector('#reservations_form_dateReservation').value;
            let time = document.querySelector('#reservations_form_hourReservation_hour').value;
            console.log(date)

            fetch(`/checkAvailability?date=${date}&time=${time}:00:00`)
                .then(response => response.json())
                .then(data => {
                    // afficher les places disponibles dans l'élément HTML approprié
                    let availablePlacesElement = document.querySelector('#available-places');
                    availablePlacesElement.innerText = data.availablePlace;
                });
        }

        const dateInput = document.querySelector('#reservations_form_dateReservation');
        const timeInput = document.querySelector('#reservations_form_hourReservation');

        dateInput.addEventListener('change', () => {
            checkAvailibility();
        });

        timeInput.addEventListener('change', () => {
            checkAvailibility();
        });



    </script>

{% endblock %}

