{% extends 'base.html.twig' %}

{% block title %}Création Administrateurs{% endblock %}

{% block body %}

    <!--FORMULAIRE INSCRIPTION ADMIN START -->

    <main class="container-fluid" style="padding-right: 0px;padding-left: 0px;">

        <div class=" block text-center">
            <img src="../img/Logo ok.jpg" class="img-fluid" alt="Logo Quai Antique">
            <h1 class="mt-3 text-center text-light">Création Administrateurs</h1>

        </div>
        <section class="container">
            <div class="row">
                <div class="col">
                    {{ form_start(registrationForm) }}
                    <fieldset>

                        {{ form_row(registrationForm.lastName) }}
                        {{ form_row(registrationForm.firstName) }}
                        {{ form_row(registrationForm.allergie) }}
                        {{ form_row(registrationForm.phoneNumber) }}
                        {{ form_row(registrationForm.email) }}
                        {{ form_row(registrationForm.password) }}
                    </fieldset>

                    <div class="text-center mb-3">
                        <button type="submit" class="btn btn-ml btn-outline-danger mt-5 text-dark">Envoyer</button>
                        {{ form_end(registrationForm) }}
                    </div>

                </div>
            </div>
        </section>

    </main>

    <!--FORMULAIRE INSCRIPTION ADMIN END -->

{% endblock %}