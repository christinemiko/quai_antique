{% extends 'base.html.twig' %}

{% block title %}Créer un Produit {% endblock %}

{% block body %}

    <!-- NEW PRODUCT START -->
       <div class=" container-fluid text-center ">
           <img src="../img/logo.jpg" class="img-fluid" alt="Logo Quai Antique">
           <h2 class="mt-3 text-center text-dark">Création d'un Produit</h2>
       </div>

       <main>

               <section class="container">
                   <div class="row">
                       <div class="col">
                           <form class="container-fluid" method="post">
                           {{ form_start(form) }}

                           <fieldset>

                               {{ form_row(form.name_product) }}

                               {{ form_row(form.unit_price) }}

                               {{ form_row(form.destination) }}

                               <div class="row  mt-3 mb-3">
                                   <div class="col col-md-6 text-dark">

                                       {{ form_row(form.category) }}
                                   </div>
                               </div>

                           </fieldset>

                           <!-- BUTTON  START -->
                           <div class="text-center mb-3">
                               <button type="submit" class="btn btn-ml btn-outline-danger mt-5 text-dark">Créer</button>

                               {{ form_end(form) }}
                           </div>
                           <!-- BUTTON  END -->

                           </form>

                       </div>

                   </div>

               </section>



       </main>
           <!-- NEW PRODUCT END->
{% endblock %}
