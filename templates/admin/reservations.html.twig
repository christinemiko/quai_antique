{% extends 'base.html.twig' %}

{% block title %}Les Réservations{% endblock %}

{% block body %}

<!-- RESERVATIONS START -->
<div class=" container-fluid text-center ">
    <img src="../img/logo.jpg" class="img-fluid" alt="Logo Quai Antique">
    <h2 class="mt-3 text-center text-dark">Les Réservations</h2>
</div>

<main>

    <!-- BUTTON CREATE RESERVATION START -->
    <div class="d-grid gap-2 col-6 mx-auto mt-3">
        <a href="{{ path('reservation') }}" class="btn btn-outline-danger btn-dark text-light" >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
            </svg> Créer une Réservation
        </a>
    </div>
    <!-- BUTTON CREATE RESERVATION END -->

    <!-- LIST RESERVATIONS START -->
    <div class="container-fluid">
        <div class="table-responsive">

            <table class="table table-light table-striped table-bordered table-hover mt-5">
                <thead >
                <tr>
                    <th class="text-center">ID</th>
                    <th class="text-center">Date de réservation</th>
                    <th class="text-center">Heure de réservation</th>
                    <th class="text-center">Nombre de Personnes</th>
                    <th class="text-center">Allergies/Message</th>
                    <th class="text-center">Client</th>
                    <th class="text-center">N°Téléphone</th>
                    <th class="text-center">Email</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>

                {% for reservations in reservations %}
                <tr>
                    <td class="text-center">{{ reservations.id }}</td>
                    <td class="text-center">{{ reservations.dateReservation|date("d/m/yy") }}</td>
                    <td class="text-center">{{ reservations.hourReservation|date('H:i:s') }}</td>
                    <td class="text-center">{{ reservations.numberPerson }}</td>
                    <td class="text-center">{{ reservations.message }}</td>
                    <td class="text-center">{{ reservations.user.lastName }}{{ reservations.user.firstName }}</td>
                    <td class="text-center">{{ reservations.user.phoneNumber }}</td>
                    <td class="text-center">{{ reservations.user.email }}</td>


                    <td class="col-md-2 text-center">
                        <a href="" class="btn btn-dark mx-2 mb-2 mt-2">Modifier</a><a href="" class="btn btn-danger">Supprimer</a>
                    </td>
                    {% endfor %}
                </tr>

                </tbody>
            </table>
        </div>
    </div>
</main>

<!-- LIST RESERVATIONS END -->

<!-- RESERVATIONS END -->
{% endblock %}