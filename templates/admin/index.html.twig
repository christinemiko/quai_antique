{% extends 'base.html.twig' %}

{% block title %}Administration Accueil{% endblock %}

{% block body %}

    <!-- ADMIN HOMEPAGE START -->

    <div class=" block text-center">
        <img src="img/Logo ok.jpg" class="img-fluid" alt="Accueil">
        <h1 class="mt-3 text-center text-light">Administration</h1>
    </div>

  <section>
      <div class="container">
        <h4 class="text-center mt-5"><i>" La simplicité  est le signe de la perfection comme dans tous les Arts." </i></h4>
        <h6 class="text-center mt-3 mb-5"> Arnaud Michant</h6>
          <div class="row justify-content-around align-items-center mt-5">

              <!-- LA CARTE CARD START -->
              <div class="card mt-4 mb-4 text-center" style="width: 18rem;">
                  <a href="{{ path('products') }}"><img src="img/logolacarte.png" class="card-img-top" alt="Logo La Carte"></a>
                  <div class="card-body">
                      <a href="{{ path('products') }}" class="text-dark">
                          <p class="card-text text-center ">La Carte/ Les Produits</p>
                      </a>
                  </div>
              </div>
              <!-- LA CARTE CARD END -->

              <!-- MENU CARD START -->
              <div class="card mt-4 mb-4 text-center" style="width: 18rem;">
                  <a href="{{ path('menus') }}"><img src="img/logomenu.png" class="card-img-top" alt="Logo Menu"></a>
                  <div class="card-body">
                      <a href="{{ path('menus') }}" class="text-dark">
                          <p class="card-text text-center ">Les Menus</p>
                      </a>
                  </div>
              </div>
              <!-- MENU CARD END -->

              <!-- RESERVATION CARD START -->
              <div class="card mt-4 mb-4 text-center" style="width: 18rem;">
                  <a href="{{ path('reservations') }}"><img src="img/logoreservation.png" class="card-img-top" alt="Logo Réservation"></a>
                  <div class="card-body">
                      <a href="{{ path('reservations') }}" class="text-dark">
                          <p class="card-text text-center ">Les Réservations</p>
                      </a>
                  </div>
              </div>
              <!-- RESERVATION CARD END -->

              <!-- CLIENTS CARD START -->
              <div class="card mt-4 mb-4 text-center" style="width: 18rem;">
                  <a href="{{ path('users') }}"><img src="img/logoclient.png" class="card-img-top" alt="Logo Client"></a>
                  <div class="card-body">
                      <a href="{{ path('users') }}" class="text-dark">
                          <p class="card-text text-center ">Les Clients</p>
                      </a>
                  </div>
              </div>
              <!-- CLIENTS CARD END -->

              <!-- IMAGE CARD START -->
              <div class="card mt-4 mb-4 text-center" style="width: 18rem;">
                  <a href="{{ path('pictures') }}"><img src="img/logoimages.png" class="card-img-top" alt="Logo Image"></a>
                  <div class="card-body">
                      <a href="{{ path('pictures') }}" class="text-dark">
                          <p class="card-text text-center ">Les Images</p>
                      </a>
                  </div>
              </div>
              <!-- IMAGE CARD END -->

              <!-- ADMIN CARD START -->
              <div class="card mt-4 mb-4 text-center" style="width: 18rem;">
                  <a href="{{ path('administrators') }}"><img src="img/logoadmin.png" class="card-img-top" alt="Logo Les Administrateurs"></a>
                  <div class="card-body">
                      <a href="{{ path('administrators') }}" class="text-dark">
                          <p class="card-text text-center ">Les Administrateurs</p>
                      </a>
                  </div>
              </div>
              <!-- ADMIN CARD END -->

              <!-- CATEGORY CARD START -->
              <div class="card mt-4 mb-4 text-center" style="width: 18rem;">
                  <a href="{{ path('categories') }}"><img src="img/logocategory.png" class="card-img-top" alt="Logo Les Catégories"></a>
                  <div class="card-body">
                      <a href="{{ path('categories') }}" class="text-dark">
                          <p class="card-text text-center ">Les Catégories</p>
                      </a>
                  </div>
              </div>
              <!-- CATEGORY CARD END -->


              <!-- HOUR CARD START -->
              <div class="card mt-4 mb-4 text-center" style="width: 18rem;">
                  <a href="{{ path('hours') }}"><img src="img/logohour.png" class="card-img-top" alt="Logo Les Horaires"></a>
                  <div class="card-body">
                      <a href="{{ path('hours') }}" class="text-dark">
                          <p class="card-text text-center ">Les Horaires</p>
                      </a>
                  </div>
              </div>
              <!-- HOUR CARD END -->


          </div>
      </div>
  </section>
        <!-- ADMIN HOMEPAGE END -->
{% endblock %}
