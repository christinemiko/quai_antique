 {% extends "base.html.twig" %}

 {% block title %}Reservation{% endblock %}

 {% block body %}

     <!-- FLATPICKR CDN -->
     <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

     <!-- RESERVATION PAGE START -->
     <main class="container-fluid" style="padding-left: 0px;padding-right: 0px;">

         <div class=" block text-center">
             <img src="img/logo ok.jpg" class="img-fluid" alt="Logo Quai Antique">
             <h1 class="mt-3 text-center text-light">Réservation</h1>
         </div>


         <section class="container">
             <div class="row">
                 <div class="col mt-5">
                   {{ form_start(reservationForm) }}
                     <fieldset>
                          {{ form_row(reservationForm.dateReservation) }}
                          {{ form_row(reservationForm.hourReservation) }}
                          {{ form_row(reservationForm.numberPerson) }}
                          {{ form_row(reservationForm.message) }}
                     </fieldset>

                     <div class="text-center mb-3">
                         <button type="submit" class="btn btn-ml btn-outline-danger mt-5 text-dark">Valider</button>
                   {{ form_end(reservationForm) }}
                     </div>
                 </div>
             </div>
         </section>
     </main>
     <!-- RESERVATION PAGE END -->

  {% block javascripts %}
      <!-- FLATPICKR   CDN -->
      <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
      <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>


      <script>
          flatpickr('.flatpickr-date', {
              dateFormat: 'd-m-Y',
              locale: 'fr',
              disableMobile: true,
              defaultDate: 'today',
              minDate: 'today',
              altInput: true,
              altFormat: 'd M Y',
              disable: [
                  function(date) {
                      return (date.getDay() === 0); // 0 = dimanche
                  }
              ],

          });

      </script>
       {% endblock %}

 {% endblock %}
