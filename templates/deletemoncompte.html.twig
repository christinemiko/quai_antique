{% extends 'base.html.twig' %}

{% block title %}Mon Compte{% endblock %}


{% block body %}
    <!-- DELETE MY ACCOUNT  START -->
<div class=" container-fluid text-center ">

    <img src="img/logo.jpg" class="img-fluid" alt="Logo Quai Antique">
      <h1 class="mt-3 text-center text-dark">Suppression Compte</h1>
    <p class="mt-5 text-danger">Attention, pour supprimer définitivement votre compte, cliquez sur le bouton "Supprimer".</p>


    {% if app.user %}
          <div class=" text-center block">
            <!-- LASTNAME  START -->
            <div class="row justify-content-center mb-4 mt-5">
                <div class="col col-md-6 text-light">
                    <label for="lastName">Nom: {{ app.user.lastName }}</label>
                </div>
            </div>
            <!-- LASTNAME  END -->

            <!-- FIRSTNAME  START -->
          <div class="row justify-content-center mb-4">
            <div class="col col-md-6 text-light">
                <label for="firstName">Prénom: {{ app.user.firstName }}</label>
            </div>
          </div>
          <!-- FIRSTNAME  END -->

          <!-- ALLERGIES  START -->
        <div class="row justify-content-center mb-4">
            <div class="col col-md-6 text-light">
                <label for="allergie">Allergies: {{ app.user.allergie }}</label>
            </div>
        </div>
        <!-- ALLERGIES  END -->

        <!-- EMAIL  START -->
        <div class="row justify-content-center mb-4">
            <div class="col col-md-6 text-light">
                <label for="allergie">Email: {{ app.user.userIdentifier }}</label>
            </div>
        </div>
        <!-- EMAIL  END -->

        <!-- PHONENUMBER START -->
        <div class="row justify-content-center mb-4">
            <div class="col col-md-6 text-light">
                <label for="allergie">Téléphone: {{ app.user.phoneNumber }}</label>
            </div>
        </div>

        <!--  PHONENUMBER   END -->
          </div>

              <!-- BUTTON DELETE  START -->
             <a  href="{{ path('deletemoncompte', { 'id': app.user.id }) }}" class= " col btn btn-ml btn-outline-danger mt-2 text-dark">
                  Supprimer
              </a>
             <!-- BUTTON DELETE  END -->

              </div>

        </div>
    {% endif %}

    <!-- DELETE MY ACCOUNT  END -->
{% endblock %}
