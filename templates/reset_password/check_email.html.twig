{% extends 'base.html.twig' %}

{% block title %}Vérification Email{% endblock %}



{% block body %}
    <div class="container-fluid">
    <div class=" text-center">
        <img src="../img/logo.jpg" class="img-fluid" alt="Logo Quai Antique">
        <h2 class="mt-3 text-center text-dark text-center">Vérification Email</h2>

    </div >

    <p class="text-center mt-5">Vous allez recevoir un email contenant un lien, vous permettant de réinitialiser votre mot de passe.</p>
        <p class="text-center">Ce lien expire dans  {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
    </p>
    <p class="text-center">Si vous n'avez pas reçu cet email, veuillez vérifier vos spams ou  <a href="{{ path('app_forgot_password_request') }}">essayez  à nouveau</a>.</p>

    </div>
{% endblock %}
