{% extends 'base.html.twig' %}

{% block title %}Reinitialisation Mot de Passe{% endblock %}

{% block body %}
    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}
    <div class="text-center">
        <img src="img/logo.jpg" class="img-fluid" alt="Logo Quai Antique">
        <h2 class="mt-3"> Réinitialisation du Mot de Passe</h2>
    </div>

     <section class="container-fluid">

        <div class="row mt-5">
             <div class="col">

                  {{ form_start(requestForm) }}
                 <div class="row justify-content-center mb-3">
                     <div class="col col-md-6 text-dark">
                 <fieldset>
                  {{ form_row(requestForm.email) }}
                 </fieldset>

                     </div>
                 </div>
             </div>
         </div>

        <div class="text-center">
            <small>
                Insérez votre email et nous vous enverrons un lien par email,
                pour réinitialiser votre mot de passe.
            </small>
        </div>

        <div class=" mb-3 mt-5 text-center">
        <button class="col btn btn-ml btn-outline-danger mt-2 text-dark">confirmer</button>
        </div>
</section>
    {{ form_end(requestForm) }}
{% endblock %}
