 {% extends "base.html.twig" %}

 {% block body %}
     <!-- HOME PAGE START -->
     <main>
           <div class=" block text-center">
                <img src="img/accueil.jpg" class="img-fluid" alt="Accueil">
           </div>

         <section>
             <div class="container">
               <h4 class="text-center mt-5"><i>" La simplicité  est le signe de la perfection comme dans tous les Arts." </i></h4>
               <h6 class="text-center mt-3 mb-5"> Arnaud Michant</h6>

         <!-- PICTURES CARD START -->
         <div class="row justify-content-center mb-4">

                    <div class="card" style="width: 60rem;">
                         <img src="img/plat2.jpg" class="card-img-top" alt="Plat2">
                         <div class="card-body">
                         <p class="card-text text-center">Gigot d'âgneau de nos régions, légumes et topinambours rôti, servi à la crème de truffe noire.</p>
                         </div>
                    </div>
         </div>
         <div class="row justify-content-center mb-4">
                    <div class="card" style="width: 60rem;">
                         <img src="img/plat8.jpg" class="card-img-top" alt="Plat8">
                         <div class="card-body">
                         <p class="card-text text-center">Soufflé à la châtaigne avec son sorbet à la fleur d'oranger, saupoudré de croquants au chocolat .</p>
                         </div>
                    </div>
         </div>
         <div class="row justify-content-center mb-4">
                    <div class="card text-center" style="width: 60rem;">
                         <img src="img/plat14.jpg" class="card-img-top" alt="Plat14">
                         <div class="card-body">
                         <p class="card-text text-center">Compressé de pomme et de coing, flambé au grand marnier , accompagné d'agrumes.</p>
                         </div>
                     </div>
         </div>

                 <!-- BUTTON RESERVATION START -->
         <div class="d-grid gap-2 col-6 mx-auto">
             <a href="{{ path('askreservation') }}" class="btn btn-ml btn-outline-danger text-dark" >
                 <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-plus-fill" viewBox="0 0 16 16">
                     <path d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                     <path fill-rule="evenodd" d="M13.5 5a.5.5 0 0 1 .5.5V7h1.5a.5.5 0 0 1 0 1H14v1.5a.5.5 0 0 1-1 0V8h-1.5a.5.5 0 0 1 0-1H13V5.5a.5.5 0 0 1 .5-.5z"/>
                 </svg>Réserver une table

             </a>
         </div>
                 <!-- BUTTON RESERVATION END -->

             </div>
         </section>
     <!-- PICTURES CARD END -->

         <!-- HOURS START -->
         <div class="container" style="padding-left: 0px;padding-right: 0px;">
         <section class="block">
         <h5 class="text-center text-light mt-5"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-clock" viewBox="0 0 16 16">
             <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/>
             <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/>
         </svg> HORAIRES</h5>
             <div class="text-center text-light"> {{ hourFixtures.day }} </div>
         <div class="text-center text-light"> {{ hourFixtures.hourtime }} </div>

         </section>
         </div>
         <!-- HOURS END -->

         <!-- ADRESS START -->
         <section>
