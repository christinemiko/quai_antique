 {% extends "base.html.twig" %}

 {% block body %}
     <!-- MENU DINER PAGE START -->
     <main class="container-fluid" style="padding-left: 0px;padding-right: 0px;">
         <div class="  text-center block">
             <img src="img/logomenudiner.jpg" class="img-fluid" alt="Logo menu diner">
         </div>

         <div class="container-fluid">
         <!--EN TÊTE MENU START -->
         <div class="row justify-content-center">
             <div class="text-center mt-5">
                 <h3>Menu Dîner</h3>
                 <p class="mt-3"> Une Entrée, un Plat, un Dessert, {{ menu.priceMenu }} {{ displayCurrency() }}  </p>
                 <p>* Du lundi au Vendredi, hors jours fériés et weekend *</p>
                 <p>* Boissons non comprises </p>
             </div>
         </div>
         <!--EN TÊTE MENU END -->

         <!--ENTREES START -->
         <div class="row justify-content-center mt-5">
             <div class="text-center">
                 <img src="img/logoentree.jpg" class="img-fluid text-center" alt="Logo les entrées">
                 {% for productMenus in productMenus %}
                     <p>{{ productMenus.product.nameProduct }}  </p>
                 {% endfor %}

             </div>
         </div>
         <!--ENTREES END -->

         <!--PLATS START -->
         <div class="row justify-content-center mt-5">
             <div class="text-center">
                 <img src="img/logoplat.jpg" class="img-fluid text-center" alt="Logo les plats">
                 {% for productMenus1 in productMenus1 %}
                     <p>{{ productMenus1.product.nameProduct }} </p>
                 {% endfor %}

             </div>
         </div>
         <!--PLATS END -->

         <!--DESSERTS START -->
         <div class="row justify-content-center mt-5">
             <div class="text-center">
                 <img src="img/logodessert.jpg" class="img-fluid text-center" alt="Logo les desserts">
                 {% for productMenus2 in productMenus2 %}
                     <p>{{ productMenus2.product.nameProduct }} </p>
                 {% endfor %}

             </div>
         </div>
         <!--DESSERTS END -->
         </div>

     </main>

     <!-- MENU DINER PAGE END -->
 {% endblock %}