 {% extends "base.html.twig" %}

 {% block body %}
     <!-- A LA CARTE PAGE START -->

  <main class="container-fluid" style="padding-left: 0px;padding-right: 0px;">

      <!-- LOGO A LA CARTE START -->
      <div class="  text-center block">
          <img src="img/logoalacarte.jpg" class="img-fluid" alt="Logo">

      </div>
      <!-- LOGO A LA CARTE END -->
      <div class="row justify-content-center">
          <div class="text-center mt-3">
               <p>* Du lundi au Samedi, à partir de 12h00 et 19h00. *</p>
          </div>
      </div>

      <div class="container-fluid">
   <!--  ENTREES START-->
      <section>
          <div class="row justify-content-center mt-3">
               <div class="text-center">
                   <img src="img/logoentree.jpg" class="img-fluid text-center" alt="Logo les entrées">
                   {% for productsFixtures in productsFixtures %}
                   <p>{{ productsFixtures.nameProduct }} {{ productsFixtures.unitPrice }}{{ displayCurrency() }}</p>
                 {% endfor %}

               </div>
          </div>

      </section>
   <!--  ENTREES END-->

   <!--  VIANDES START-->
      <section>
          <div class="row justify-content-center mt-5">
               <div class="text-center">
                   <img src="img/logoviande.jpg" class="img-fluid text-center" alt="Logo les viandes">
                   {% for productsFixtures2 in productsFixtures2 %}
                       <p>{{ productsFixtures2.nameProduct }} {{ productsFixtures2.unitPrice }}{{ displayCurrency() }}</p>
                   {% endfor %}

               </div>
          </div>

      </section>
   <!--  VIANDES END-->

      <!--  POISSONS START-->
      <section>
          <div class="row justify-content-center mt-5">
              <div class="text-center">
                  <img src="img/logopoisson.jpg" class="img-fluid text-center" alt="Logo les poissons">
                  {% for productsFixtures3 in productsFixtures3 %}
                      <p>{{ productsFixtures3.nameProduct }} {{ productsFixtures3.unitPrice }}{{ displayCurrency() }}</p>
                  {% endfor %}

              </div>
          </div>
      </section>
      <!--  POISSONS END-->

      <!--  FROMAGES START-->
      <section>
          <div class="row justify-content-center mt-5">
              <div class="text-center">
                  <img src="img/logofromage.jpg" class="img-fluid text-center" alt="Logo les fromages">
                  {% for productsFixtures4 in productsFixtures4 %}
                      <p>{{ productsFixtures4.nameProduct }} {{ productsFixtures4.unitPrice }}{{ displayCurrency() }}</p>
                  {% endfor %}
              </div>
          </div>
      </section>
      <!--  FROMAGES END-->

      <!--  DESSERTS START-->
      <section>
          <div class="row justify-content-center mt-5">
              <div class="text-center">
                  <img src="img/logodessert.jpg" class="img-fluid text-center" alt="Logo les desserts">
                  {% for productsFixtures5 in productsFixtures5 %}
                      <p>{{ productsFixtures5.nameProduct }} {{ productsFixtures5.unitPrice }}{{ displayCurrency() }}</p>
                  {% endfor %}

              </div>
          </div>
      </section>
      <!--  DESSERTS END-->

      <!--  BOISSONS START-->
      <section>
          <div class="row justify-content-center mt-5">
              <div class="text-center">
                  <img src="img/logoboisson.jpg" class="img-fluid text-center" alt="Logo les boissons">
                  {% for productsFixtures6 in productsFixtures6 %}
                      <p>{{ productsFixtures6.nameProduct }} {{ productsFixtures6.unitPrice }}{{ displayCurrency() }}</p>
                  {% endfor %}
              </div>
          </div>
      </section>
      <!--  BOISSONS END-->

      <!--  VINS START-->
      <section>
          <div class="row justify-content-center mt-5">
              <div class="text-center">
                  <img src="img/logovin.jpg" class="img-fluid text-center" alt="Logo la carte des vins">
                  {% for productsFixtures7 in productsFixtures7 %}
                      <p>{{ productsFixtures7.nameProduct }} {{ productsFixtures7.unitPrice }}{{ displayCurrency() }}</p>
                  {% endfor %}
              </div>
          </div>
      </section>
      <!--  VINS END-->
      </div>

  </main>

     <!-- A LA CARTE PAGE END -->
 {% endblock %}
