 {% extends "base.html.twig" %}

 {% block body %}
     <!-- HISTORY  PAGE START -->
     <div class="mt-3 text-center"><img src="img/logo.jpg" alt="Logo quai_antique" class="img-fluid" ></div>

     <div class="container-fluid">

         <!-- PRESENTATION LIEU START -->
               <div class="row  justify-content-center">
                  <div class="col-sm-6">

                      <div id="carouselExample" class="carousel slide">
                         <div class="carousel-inner">

                             <div class="carousel-item active">
                                <img src="img/lieu2.jpg" class="d-block w-100" alt="lieu2">
                             </div>

                             <div class="carousel-item">
                               <img src="img/lieu3.jpg" class="d-block w-100" alt="lieu3">
                             </div>

                             <div class="carousel-item">
                               <img src="img/lieu4.jpg" class="d-block w-100" alt="lieu4">
                             </div>

                             <div class="carousel-item">
                               <img src="img/lieu5.jpg" class="d-block w-100" alt="lieu5">
                             </div>

                         </div>

                          <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                             <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                             <span class="visually-hidden">Previous</span>
                          </button>
                          <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                          </button>

                      </div>

                  </div>

                      <div class="col align-self-center col-sm-4">
                       <h3>Le gout de l'essentiel dans un lieu atypique</h3>
                          <p>Une passion immense du goût, une philosophie de la nature et du terroir,
                          Quai Antique présente la poésie du chef Arnaud Michant,
                          orchestrée au sein du restaurant gastronomique de la Maison,
                          situé sur une péniche au bord du lac d'Annecy.
                          </p>
                      </div>
               </div>
         <!--PRESENTATION LIEU END -->

         <!--IMAGE PLAT START -->
             <div class=" text-center ">
                 <img src="img/plat3.jpg" alt="Plat3" class="img-fluid" >
             </div>
         <!--IMAGE PLAT END -->

         <!-- PRESENTATION CHEF START -->
         <div class="row justify-content-center">

             <div class="col align-self-center col-sm-4">
                 <h3>l'Artisan du goût</h3>
                 <p>Souvenirs affectifs, émotions partagées.
                     Le chef Arnaud Michant esquisse les premières notes d'une symphonie gourmande au restaurant
                     gastronomique Quai Antique à Annecy. Couleurs, textures et saveurs se mêlent avec délicatesse,
                     tel un hommage sentimental aux producteurs de la région et à l'essence profonde des produits
                     de la nature.
                 </p>
             </div>

             <div class="col-sm-6 text-center">
                 <img src="img/chef1.jpg" alt="Chef" class="img-fluid" >
             </div>

         </div>
         <!-- PRESENTATION CHEF END -->

     </div>

     <!-- HISTORY PAGE END -->
 {% endblock %}