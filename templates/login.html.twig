 {% extends "base.html.twig" %}

 {% block body %}

     <!-- LOGIN PAGE START -->

     <div class="text-center">
         <img src="img/logo.jpg" class="img-fluid" alt="Logo Quai Antique">
     </div>

     <!-- CONNEXION FORMULAIRE START -->
     <form class="container-fluid" method="POST">
         <h1 class="mt-3 text-center text-dark">Connexion</h1>
         <!-- EMAIL  START -->
         <div class="row justify-content-center mb-3">
             <div class="col col-md-6 text-dark">
                 <label for="email">Email: </label>
                 <input type="email" name="email" class="form-control" id="InputEmail1"
                        placeholder="Insérez Votre Email" autocomplete="off" required="required">
             </div>
         </div>
         <!-- EMAIL  END -->

         <!-- PASSWORD  START -->
         <div class="row justify-content-center mb-3">
             <div class="col col-md-6 text-dark">
                 <label for="password">Mot de passe: </label>
                 <input type="password" name="password" class="form-control" id="InputPassword1"
                        placeholder="Insérez Votre Mot de Passe" autocomplete="off" required="required">
             </div>
         </div>
         <!-- PASSWORD  START -->

         <!-- BUTTON  START -->
         <div class=" mb-3 mt-5 text-center">
             <button type="submit" name="login" class=" col btn btn-ml btn-outline-danger mt-2 text-dark">
                 Se connecter</button>
         </div>

         <p class="text-center mt-4"><a class="text-dark" href={{ path('oubli_motdepasse') }} > J'ai oublié mon Mot de passe.</a></p>
         <!-- BUTTON  END -->

         <p class="text-center mt-2 text-dark">Je n'ai pas de compte.<a class="text-danger" href={{ path('sinscrire') }} > Je m'inscris.</a></p>

     </form>
     <!-- CONNEXION FORMULAIRE END -->

     <!-- LOGIN PAGE END -->

 {% endblock %}