 {% extends "base.html.twig" %}

 {% block body %}
     <!-- HOME PAGE START -->
     <div class="text-center">
         <img src="img/accueil.jpg" class="img-fluid img1" alt="Accueil">
     </div>

     <div class="container">
         <h2 class="text-center mt-5"><i>" La simplicité  est le signe de la perfection comme dans tous les Arts." </i></h2>
         <h3 class="text-center mt-2 mb-5"> Arnaud Michant</h3>

         <!-- PICTURES GALERY START -->
         <div class="row justify-content-center mb-4">

                    <div class="card" style="width: 60rem;">
                         <img src="img/plat2.jpg" class="card-img-top" alt="Plat2">
                         <div class="card-body">
                         <p class="card-text">Gigot d'agneau de nos régions, légumes et topinambours rôti, servi à la crème de truffe noire.</p>
                         </div>
                    </div>
         </div>
         <div class="row justify-content-center mb-4">
                    <div class="card" style="width: 60rem;">
                         <img src="img/plat8.jpg" class="card-img-top" alt="Plat8">
                         <div class="card-body">
                         <p class="card-text">Soufflé à la châtaigne avec son sorbet à la fleur d'oranger, saupoudré de croquants au chocolat .</p>
                         </div>
                    </div>
         </div>
         <div class="row justify-content-center mb-4">
                    <div class="card text-center" style="width: 60rem;">
                         <img src="img/plat14.jpg" class="card-img-top" alt="Plat14">
                         <div class="card-body">
                         <p class="card-text">Compressé de pomme et de coing, flambé au grand marnier , accompagné d'agrumes.</p>
                         </div>
                     </div>
         </div>

         <div class="d-grid gap-2 col-6 mx-auto">
             <button class="btn btn-outline-danger btn-light text-dark" type="button">
                 <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-plus-fill" viewBox="0 0 16 16">
                     <path d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                     <path fill-rule="evenodd" d="M13.5 5a.5.5 0 0 1 .5.5V7h1.5a.5.5 0 0 1 0 1H14v1.5a.5.5 0 0 1-1 0V8h-1.5a.5.5 0 0 1 0-1H13V5.5a.5.5 0 0 1 .5-.5z"/>
                 </svg>
                 <a href="reservation.html.twig" class="text-dark">
                     Réserver
             </button><br></a>
         </div>

         <!-- PICTURES GALERY END -->
     </div>


     <!-- HOME PAGE END -->
 {% endblock %}