{% extends 'base.html.twig' %}

{% block title %}Modification{% endblock %}

{% block body %}

    <!--FORMULAIRE INSCRIPTION START -->

    <main class="container-fluid" style="padding-right: 0px;padding-left: 0px;">

        <div class=" block text-center">
            <img src="img/Logo ok.jpg" class="img-fluid" alt="Logo Quai Antique">
            <h1 class="mt-3 text-center text-light">Modification Compte</h1>

        </div>
        <section class="container">
            <div class="row">
                <div class="col">
                    {{ form_start(edituserForm) }}
                    <fieldset>

                        {{ form_row(edituserForm.last_name) }}
                        {{ form_row(edituserForm.first_name) }}
                        {{ form_row(edituserForm.allergie) }}
                        {{ form_row(edituserForm.phone_number) }}
                        {{ form_row(edituserForm.email) }}
                    </fieldset>

                    <div class="text-center mb-3">
                        <button type="submit" class="btn btn-ml btn-outline-danger mt-5 text-dark">Enregistrer</button>
                        {{ form_end(edituserForm) }}
                    </div>

                </div>
            </div>
        </section>

    </main>

    <!--FORMULAIRE INSCRIPTION END -->

{% endblock %}
