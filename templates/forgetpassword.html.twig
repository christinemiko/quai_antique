 {% extends "base.html.twig" %}

 {% block body %}

     <!-- FORGET PASSWORD PAGE START -->

     <div class="text-center">
         <img src="img/logo.jpg" class="img-fluid" alt="Logo Quai Antique">
         <h1 class="mt-3"> Réinitialisation du Mot de Passe</h1>
     </div>

     <div class="text-center">
         <p class="mt-5 "> Votre demande de réinitialisation de mot de passe, va être prise en charge.</p>
         <p>Insérez votre email ci-dessous. </p>
         <p> Vous recevrez un email de confirmation,
             pour réinitialiser votre mot de passe.</p>
         <p class="mb-5 ">Si vous n'êtez pas l'auteur de cette demande , veuillez
         ignorer ce message.</p>
     </div>

     <!-- CONNEXION FORMULAIRE START -->
     <form class="container-fluid mt-3 mb-3" method="POST">

         <!--EMAIL START -->
         <div class="row justify-content-center mb-3">
             <div class="col col-md-6">
                 <label for="email">Email: </label>
                 <input type="text" name="email" id="email" placeholder="Insérez votre Email" class="form-control"
                        required="required">
             </div>
         </div>
         <!--EMAIL END -->

         <!-- BUTTON  START -->
         <div class=" mb-3 mt-5 text-center">
             <button type="submit" name="submit" class=" col btn btn-ml btn-outline-danger mt-2 text-dark">
                 Confirmer </button>
         </div>

     </form>
     <!-- CONNEXION FORMULAIRE END -->

     <!-- LOGIN PAGE END -->

 {% endblock %}